[Unit]
Description=SpacemiT LingLong @PROFILE_LABEL@ (profile=@PROFILE@)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=@GROUP@
WorkingDirectory=@SDK_ROOT@
Environment="SDK_ROOT=@SDK_ROOT@"
Environment="HOME=@HOME@"
Environment="LINGLONG_CONFIG=@SDK_ROOT@/application/native/humanoid_linglong/config/@CONFIG@"
ExecStartPre=@SDK_ROOT@/output/staging/bin/configure_can_linglong.sh --profile @PROFILE@
ExecStart=@SDK_ROOT@/output/staging/bin/run_linglong.sh --real --profile @PROFILE@ --service-user @USER@@NETWORK_ARGS@
KillMode=mixed
KillSignal=SIGINT
SuccessExitStatus=130 143
TimeoutStopSec=15
Restart=no

[Install]
WantedBy=multi-user.target
